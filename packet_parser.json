{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "start"
          },
          "bytes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\[?\\s*(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2})(?:[\\s,]+(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2}))*\\s*\\]?$",
                "title": "One magic word"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Several magic words"
              }
            ],
            "label": "Magic word",
            "fullWidth": true
          },
          "key": {
            "label": "Name",
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "emit": {
            "label": "Include in output",
            "type": "boolean"
          },
          "if": {
            "label": "If",
            "fullWidth": true,
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "type",
          "bytes"
        ],
        "additionalProperties": false,
        "title": "Start — scan for magic word"
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "skip"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "title": "Fixed count"
              },
              {
                "type": "string",
                "title": "Expression or hex"
              }
            ],
            "label": "Bytes",
            "fullWidth": true
          },
          "if": {
            "label": "If",
            "fullWidth": true,
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "type",
          "count"
        ],
        "additionalProperties": false,
        "title": "Skip — discard bytes"
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "length"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "label": "Name"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "label": "Width (bytes)"
          },
          "endian": {
            "type": "string",
            "enum": [
              "le",
              "be"
            ],
            "label": "Byte order"
          },
          "adjustment": {
            "label": "Adjustment",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "emit": {
            "label": "Include in output",
            "type": "boolean"
          },
          "if": {
            "label": "If",
            "fullWidth": true,
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "type",
          "key",
          "size",
          "endian"
        ],
        "additionalProperties": false,
        "title": "Length — read a byte count"
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "read"
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "title": "Fixed count"
              },
              {
                "type": "string",
                "title": "Expression or hex"
              }
            ],
            "label": "Bytes",
            "fullWidth": true
          },
          "if": {
            "label": "If",
            "fullWidth": true,
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "type",
          "count"
        ],
        "additionalProperties": false,
        "title": "Read — append bytes"
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "until"
          },
          "bytes": {
            "type": "string",
            "pattern": "^\\[?\\s*(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2})(?:[\\s,]+(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2}))*\\s*\\]?$",
            "label": "End marker",
            "fullWidth": true
          },
          "emit": {
            "label": "Include marker in output",
            "type": "boolean"
          },
          "escape": {
            "label": "Escape",
            "fullWidth": true,
            "type": "object",
            "properties": {
              "byte": {
                "type": "string",
                "pattern": "^(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2})$",
                "label": "Escape byte"
              },
              "decode": {
                "label": "Decode",
                "type": "boolean"
              },
              "map": {
                "label": "Translations",
                "fullWidth": true,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2})$",
                      "label": "From"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^(?:0[xX][0-9a-fA-F]{1,2}|25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[0-9]{1,2})$",
                      "label": "To"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "title": "Translation"
                }
              }
            },
            "required": [
              "byte"
            ],
            "additionalProperties": false
          },
          "if": {
            "label": "If",
            "fullWidth": true,
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "type",
          "bytes"
        ],
        "additionalProperties": false,
        "title": "Until — read to end marker"
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "listen"
          },
          "max_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "label": "Max bytes",
            "fullWidth": true
          }
        },
        "required": [
          "type",
          "max_bytes"
        ],
        "additionalProperties": false,
        "title": "Listen — flush on size or timeout"
      }
    ]
  },
  "x-form": true,
  "title": "Packet steps",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "eval"
            },
            "receiver": {
              "type": "string",
              "label": "Receiver",
              "fullWidth": true
            },
            "operator": {
              "type": "string",
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">="
              ],
              "label": "Operator"
            },
            "length": {
              "label": "Compare length",
              "type": "boolean"
            },
            "datatype": {
              "type": "string",
              "enum": [
                "BOOL",
                "INT",
                "FLOAT",
                "STRING",
                "BYTES"
              ],
              "label": "Data type"
            },
            "value": {
              "label": "Value",
              "fullWidth": true
            }
          },
          "required": [
            "type",
            "receiver",
            "operator"
          ],
          "additionalProperties": false,
          "title": "Compare to value"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "eval"
            },
            "receiver": {
              "type": "string",
              "label": "Receiver",
              "fullWidth": true
            },
            "operator": {
              "type": "string",
              "enum": [
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">="
              ],
              "label": "Operator"
            },
            "length": {
              "label": "Compare length",
              "type": "boolean"
            },
            "value_receiver": {
              "type": "string",
              "label": "Value receiver",
              "fullWidth": true
            }
          },
          "required": [
            "type",
            "receiver",
            "operator",
            "value_receiver"
          ],
          "additionalProperties": false,
          "title": "Compare to receiver"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "and"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "operands"
          ],
          "additionalProperties": false,
          "title": "All of (AND)"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "or"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "operands"
          ],
          "additionalProperties": false,
          "title": "Any of (OR)"
        }
      ]
    }
  }
}
