{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "label": "ID"
          },
          "type": {
            "type": "string",
            "const": "static"
          },
          "data": {
            "type": "string",
            "label": "Data",
            "fullWidth": true
          },
          "data_type": {
            "type": "string",
            "enum": [
              "U8",
              "U16",
              "U32",
              "U64",
              "I8",
              "I16",
              "I32",
              "I64",
              "F32",
              "F64",
              "BOOL",
              "STRING",
              "BYTES"
            ],
            "label": "Data type"
          },
          "endian": {
            "type": "string",
            "enum": [
              "le",
              "be"
            ],
            "label": "Byte order"
          }
        },
        "required": [
          "id",
          "type",
          "data",
          "data_type"
        ],
        "additionalProperties": false,
        "title": "Static — fixed value"
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "label": "ID"
          },
          "type": {
            "type": "string",
            "const": "dynamic"
          },
          "key": {
            "type": "string",
            "label": "Key",
            "fullWidth": true
          },
          "data_type": {
            "type": "string",
            "enum": [
              "U8",
              "U16",
              "U32",
              "U64",
              "I8",
              "I16",
              "I32",
              "I64",
              "F32",
              "F64",
              "BOOL",
              "STRING",
              "BYTES"
            ],
            "label": "Data type"
          },
          "endian": {
            "type": "string",
            "enum": [
              "le",
              "be"
            ],
            "label": "Byte order"
          }
        },
        "required": [
          "id",
          "type",
          "key",
          "data_type",
          "endian"
        ],
        "additionalProperties": false,
        "title": "Dynamic — from input key"
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "label": "ID"
          },
          "type": {
            "type": "string",
            "const": "metadata_length"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "label": "Field IDs",
            "fullWidth": true
          },
          "data_type": {
            "type": "string",
            "enum": [
              "U8",
              "U16",
              "U32",
              "U64"
            ],
            "label": "Data type"
          },
          "endian": {
            "type": "string",
            "enum": [
              "le",
              "be"
            ],
            "label": "Byte order"
          },
          "count": {
            "label": "Count fields",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type",
          "ids",
          "data_type",
          "endian"
        ],
        "additionalProperties": false,
        "title": "Length — of other fields"
      }
    ]
  },
  "x-form": true,
  "title": "Byte fields"
}
